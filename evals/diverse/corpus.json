                "line 2",
                "link"
              ]
            ]
          ],
          [
            "GET",
            "/settings",
            "declared",
            [
              [
                "source_1",
                "line 3",
                "link"
              ]
            ]
          ]
        ],
        "unresolved": []
      }
    },
