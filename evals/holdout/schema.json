{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jgolding1998/surface-map/evals/holdout/schema.json",
  "title": "Surface Map project-separated capture evaluation",
  "description": "Structural schemas. Runtime validation additionally checks hashes, unique identities, label coverage, local paths, dates, review rules and project/capture split leakage. Metadata are self-reported, not attestations.",
  "oneOf": [
    {
      "$ref": "#/$defs/corpus"
    },
    {
      "$ref": "#/$defs/labels"
    },
    {
      "$ref": "#/$defs/predictions"
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "revision",
        "license",
        "retrieved_at"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^source_[1-6]$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "link",
            "form",
            "har",
            "javascript"
          ]
        }
      },
      "required": [
        "source",
        "location",
        "kind"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "enum": ["unverified_global_axios"]
      },
      "maxItems": 1,
      "uniqueItems": true
    },
    "route": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]{1,20}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "confidence": {
          "enum": [
            "declared",
            "inferred",
            "observed"
          ]
        },
        "evidence_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "link",
              "form",
              "har",
              "javascript"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "assumptions": {
          "$ref": "#/$defs/assumptions"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "method",
        "path",
        "confidence",
        "evidence_kinds"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "confidence": {
          "const": "inferred"
        },
        "evidence_kinds": {
          "const": [
            "javascript"
          ]
        },
        "assumptions": {
          "$ref": "#/$defs/assumptions"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "confidence",
        "evidence_kinds"
      ],
      "additionalProperties": false
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "routes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/route"
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "unresolved": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/unresolved"
              },
              "minItems": 0,
              "maxItems": 1000
            }
          },
          "required": [
            "routes",
            "unresolved"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rejected": {
              "const": true
            }
          },
          "required": [
            "rejected"
          ],
          "additionalProperties": false
        }
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "agent-reviewed",
            "human-reviewed"
          ]
        },
        "reviewer": {
          "type": "string",
          "maxLength": 256
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "development",
            "holdout"
          ]
        },
        "kind": {
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "exposure": {
          "enum": [
            "unseen",
            "exposed",
            "unknown"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "group",
        "split",
        "kind",
        "provenance"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "html",
            "har",
            "javascript",
            "typescript"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1,
          "maxItems": 6
        },
        "document_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "project",
        "family",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "surface-map-holdout-corpus/1"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "schema",
        "name",
        "projects",
        "cases"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "surface-map-holdout-labels/1"
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
              },
              "review": {
                "$ref": "#/$defs/review"
              },
              "expected": {
                "$ref": "#/$defs/expected"
              }
            },
            "required": [
              "id",
              "review",
              "expected"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "schema",
        "corpus_sha256",
        "labels"
      ],
      "additionalProperties": false
    },
    "predictions": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "surface-map-holdout-predictions/1"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "results": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
                  },
                  "routes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/route"
                    },
                    "minItems": 0,
                    "maxItems": 1000
                  },
                  "unresolved": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/unresolved"
                    },
                    "minItems": 0,
                    "maxItems": 1000
                  }
                },
                "required": [
                  "id",
                  "routes",
                  "unresolved"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
                  },
                  "rejected": {
                    "const": true
                  }
                },
                "required": [
                  "id",
                  "rejected"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "schema",
        "input_sha256",
        "results"
      ],
      "additionalProperties": false
    }
  }
}
